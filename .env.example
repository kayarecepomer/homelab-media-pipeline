# Copy to .env and fill in. Never commit the real .env (it is in .gitignore).

# VPN (from your provider's WireGuard config)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESS=10.2.0.2/32
VPN_COUNTRY=United States

# Networks the VPN container must still be able to reach (LAN + Tailscale)
LAN_SUBNET=192.168.1.0/24
TAILSCALE_SUBNET=100.64.0.0/10

# One folder holding both "torrents/" and "media/" (same filesystem)
MEDIA_ROOT=/srv/data

TZ=Etc/UTC
